{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LoginNoEcr",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "EcrDoWeb",
      "Effect": "Allow",
      "Action": "ecr:*",
      "Resource": "arn:aws:ecr:${regiao}:${conta}:repository/autoreparos-web"
    },
    {
      "Sid": "DescreverOCluster",
      "Effect": "Allow",
      "Action": "eks:DescribeCluster",
      "Resource": "arn:aws:eks:${regiao}:${conta}:cluster/${cluster}"
    }
  ]
}
