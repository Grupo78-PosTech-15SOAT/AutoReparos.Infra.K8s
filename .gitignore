# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# tfplan files
*.tfplan*

# Helm package archives
*.tgz
Chart.lock

# System files
.DS_Store
.terraformrc
terraform.rc
